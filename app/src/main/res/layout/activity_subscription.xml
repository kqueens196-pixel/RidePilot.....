<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Subscription Plan"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your payment method below"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="30dp" />

        <!-- UPI Payment Option -->
        <Button
            android:id="@+id/btnSubscribeUpi"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pay with UPI (GPay / PhonePe / Paytm)"
            android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Debit / Credit Card Option -->
        <Button
            android:id="@+id/btnPayCard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pay via Debit / Credit Card"
            android:backgroundTint="#1E293B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Net Banking Option -->
        <Button
            android:id="@+id/btnPayNetBanking"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pay via Net Banking"
            android:backgroundTint="#1E293B"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <!-- Free Trial Option -->
        <Button
            android:id="@+id/btnFreeTrial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Start 7-Day Free Trial"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</ScrollView>
